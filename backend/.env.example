# Solo para desarrollo local. En Cloud Run no existe este archivo: las variables
# las fija deploy.ps1.

# Identidad de desarrollo. En local, si no hay cookie de sesión, el backend toma
# este correo (o el header x-dev-user-email, que es lo que usan las pruebas).
# En Cloud Run se IGNORA: solo vale la cookie que emite la pantalla de ingreso.
DEV_USER_EMAIL=hernando.castellanos@osctopsolutionsgroup.com
PORT=8080

# Proyecto GCP y raíz de Firestore. Deje "sgc_dev" en local para no tocar los
# datos de la demostración (raíz "sgc"). Requiere credenciales ADC:
#   gcloud auth application-default login
GCP_PROJECT_ID=gad-ibarra-documental
SGC_ROOT=sgc_dev

# Almacenamiento de archivos. Sin esta variable se usa el disco local
# (backend/data/storage). En Cloud Run es OBLIGATORIA: el disco es efímero.
# STORAGE_BUCKET=gad-ibarra-documental-archivos

# Secreto con el que se firma la cookie de sesión. En local se genera uno por
# proceso si falta; en Cloud Run lo fija deploy.ps1.
# SESION_SECRETO=

# Correo. Esta instalación NO envía correo (solo bandeja interna): ver
# lib/mailer.js para conectar un transporte. MAIL_ENVIAR=1 sin transporte solo
# deja el error registrado en cada notificación.
# MAIL_ENVIAR=0

# Base de los enlaces en las notificaciones.
# APP_BASE_URL=http://localhost:5173
